# Prefer scripts/setup.py for a new installation; it creates .env and local secret files.
# For manual setup: copy to .env and replace the placeholders. Never put access tokens here.

# Choose ONE access mode (Linux/macOS separator ":"; on Windows use ";"):
# local: loopback HTTP only; https: Caddy with any DNS provider; external: own TLS proxy;
# ionos: optional DNS-01 plugin. CLI -f flags take precedence over COMPOSE_FILE.
COMPOSE_FILE=compose.yaml:compose.local.yaml

# File owner in the containers (setup.py detects the host user).
APP_UID=1000
APP_GID=1000
# Kickbase credentials are file secrets; custom absolute paths also work.
KICKBASE_EMAIL_FILE=./secrets/kickbase_email
KICKBASE_PASSWORD_FILE=./secrets/kickbase_password
# Only used by compose.ionos.yaml; not needed for other modes.
IONOS_TOKEN_FILE=./secrets/ionos_token
# The local/external app port always binds to 127.0.0.1.
APP_HTTP_PORT=8080
# Only used by HTTPS/IONOS proxy modes; restrict to a private interface if desired.
PROXY_BIND_ADDRESS=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- App ---
LOG_LEVEL=INFO
TZ=Europe/Berlin
KICKBASE_LEAGUE_NAME="Meine Liga"

# Kickbase access (optional, defaults shown): minimum seconds between requests and cache
# lifetimes in seconds. App and worker each send one request at a time.
KICKBASE_MIN_INTERVAL=0.25
WORKER_MIN_INTERVAL=1.0
CACHE_TTL_LIVE=600
CACHE_TTL_PLAYER=1800
CACHE_TTL_STATIC=86400

# Argon2 hash of the app login password: uv run python scripts/hash_password.py
# Keep the single quotes, otherwise Docker Compose interprets the `$` signs.
APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE$REPLACE'
# Random string, at least 32 characters: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_ME
SESSION_MAX_AGE_DAYS=30
# Secure cookies by default; only compose.local.yaml overrides this for local HTTP.
SESSION_HTTPS_ONLY=true

# --- Telegram notifications (worker) ---
# Chat that receives the messages (send /start to the bot, then read the id via getUpdates).
# The bot token is a Docker secret: put it into ./secrets/telegram_bot_token (gitignored).
TELEGRAM_CHAT_ID=
PUBLIC_URL=http://localhost:8080
# For HTTPS/external/IONOS: change this to your own https://hostname (no path).

# --- Language model (worker: news extraction, daily briefing) ---
# OpenAI-compatible chat completions; the key is a Docker secret in ./secrets/llm_api_key
# (gitignored). Without it everything runs without AI. Hard limits: config/ai.yaml.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-14b-latest
LLM_FALLBACK_MODEL=ministral-8b-latest

# --- Claude im Telegram-Chat (@claude) ---
# Bridge on the VM host (deploy/claude-bridge/), token in ./secrets/claude_bridge_token
# (gitignored, empty = off). Window, models and limits: config/ai.yaml (section claude).
CLAUDE_BRIDGE_URL=http://host.docker.internal:8767
CLAUDE_MCP_PORT=8768

# --- Database (only reachable inside the Docker network) ---
POSTGRES_USER=kickbase
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=kickbase
